<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.queryon</groupId>
    <artifactId>queryon-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>queryon-bootstrap</artifactId>
  <name>Queryon Bootstrap</name>
  <description>启动类、示例数据集初始化、配置装配</description>

  <dependencies>
    <dependency>
      <groupId>com.queryon</groupId>
      <artifactId>queryon-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- PostgreSQL JDBC 驱动（05 第 7 节定稿组合）：仅运行时加载，版本由 Boot BOM 锁定。
         数据源配置与持久化接入待 05 第 10 节未决项及依赖可行性验证触发。 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- JDBC 数据源与事务：dev profile 下从 PostgreSQL 取数（version 由 Boot BOM 锁定） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- 结果缓存：dev profile 下用 Redis 缓存受治理查询结果（version 由 Boot BOM 锁定） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
